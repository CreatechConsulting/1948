<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>WorkManagement.Client</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Work Management Dashboard</ApplicationTitle>
    <ApplicationId>com.example.workmanagement</ApplicationId>
    <ApplicationVersion>1.0.0</ApplicationVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\WorkManagement.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="9.0.0" />
    <PackageReference Include="DevExpress.Maui.Blazor" Version="25.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.0-preview.7.24405.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0-preview.7.24405.2" />
    <PackageReference Include="Refit" Version="7.1.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="7.1.0" />
  </ItemGroup>
  <ItemGroup>
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiAsset Include="wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiImage Include="Resources\Images\**" />
    <MauiRazor Include="_Imports.razor" />
    <MauiRazor Include="Main.razor" />
    <MauiRazor Include="Pages\**\*.razor" />
    <MauiRazor Include="Shared\**\*.razor" />
    <MauiXaml Include="App.xaml" />
    <MauiXaml Include="MainPage.xaml" />
    <MauiXaml Include="Resources\Styles\Styles.xaml" />
    <MauiCss Include="wwwroot\css\**\*.css" />
  </ItemGroup>
</Project>
